---
interface Props {
  category: string;
  items: string[];
}

const { category, items } = Astro.props;
---

<p class="skill-row">
  <span class="skill-label">{category}<span class="colon">:</span></span>{
    " "
  }<span class="skill-list">{items.join(" · ")}</span>
</p>

<style>
  /* ---- screen: dark resume sidebar, category above list ---- */
  @media screen {
    .skill-row {
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
    }

    .skill-label {
      font-family: var(--font-display);
      font-size: var(--fs-xs);
      font-weight: 600;
      color: var(--text-2);
    }

    .colon {
      display: none;
    }

    .skill-list {
      font-size: var(--fs-xs);
      line-height: var(--lh-base);
      color: var(--muted);
    }
  }

  /* ---- print: "Category: item · item" inline ---- */
  @media print {
    .skill-row {
      margin: 0;
      color: var(--print-ink);
      font-size: 10pt;
      line-height: var(--lh-base);
    }

    .skill-label {
      font-weight: 600;
      color: var(--print-ink);
    }
  }
</style>
