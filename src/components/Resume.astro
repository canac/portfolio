---
import { profile } from "../data/profile";
import Education from "./Education.astro";
import Experience from "./Experience.astro";
import Link from "./Link.astro";
import NameHeading from "./NameHeading.astro";
import SkillGroup from "./SkillGroup.astro";

const { title, phone, email, location, website, github, linkedin } = profile;
---

<article class="resume">
  <div class="aside">
    <div class="aside-inner">
      <a class="back" href="/">&larr; Back to portfolio</a>
      <header class="identity">
        <NameHeading />
        <p class="contact">
          <span class="contact-line">
            <span>{phone}</span>
            <span class="sep" aria-hidden="true">&middot;</span>
            <Link href={`mailto:${email}`} />
            <span class="sep" aria-hidden="true">&middot;</span>
            <span>{location}</span>
          </span>
          <span class="sep sep-group" aria-hidden="true">&middot;</span>
          <span class="contact-line">
            <Link href={website} external />
            <span class="sep" aria-hidden="true">&middot;</span>
            <Link href={github} external />
            <span class="sep" aria-hidden="true">&middot;</span>
            <Link href={linkedin} external />
          </span>
        </p>
      </header>
      <a class="pdf-btn" href="/resume.pdf" download>Download PDF</a>

      <div class="side-rule" aria-hidden="true"></div>

      <h2 class="section-label label-skills">Skills</h2>
      <div class="skills">
        <SkillGroup
          category="Languages"
          items={["TypeScript", "JavaScript", "Ruby", "SQL"]}
        />
        <SkillGroup
          category="Frameworks & Libraries"
          items={["React", "Next.js", "Ruby on Rails", "Node.js"]}
        />
        <SkillGroup
          category="Web"
          items={["REST APIs", "GraphQL", "HTML", "CSS", "Tailwind CSS"]}
        />
        <SkillGroup
          category="Infrastructure"
          items={["AWS", "PostgreSQL", "GitHub Actions", "Docker", "CI/CD"]}
        />
        <SkillGroup category="Testing" items={["Jest", "RSpec"]} />
        <SkillGroup
          category="Developer Tools"
          items={["Git", "shell scripting", "Claude Code"]}
        />
      </div>

      <div class="side-rule" aria-hidden="true"></div>

      <h2 class="section-label label-education">Education</h2>
      <div class="education">
        <Education
          school="Thomas Edison State University"
          degree="Bachelor of Science in Computer Science"
          date="03/2016"
        />
      </div>
    </div>
  </div>

  <div class="main">
    <p class="summary">
      Senior full-stack software engineer with 5 years of experience building
      and modernizing large-scale TypeScript, Ruby on Rails, and React
      applications. Leads cross-functional initiatives, modernizing legacy
      applications, improving performance, and mentoring engineers across
      complex web platforms.
    </p>
    <h2 class="section-label label-experience">Experience</h2>
    <div class="main-rule" aria-hidden="true"></div>
    <div class="roles">
      <Experience
        company="Cru"
        title={title}
        start="10/2022"
        end="Present"
        bullets={[
          "Migrated a custom authentication system to Okta for a donation platform processing $75M annually, seamlessly transitioning 380,000 users with no production incidents.",
          "Served as technical lead for multiple cross-functional initiatives, defining system architecture, decomposing work, coordinating implementation across engineers, and driving projects from planning through production delivery.",
          "Led a multi-year migration of a donor CRM from AngularJS to React, modernizing the frontend architecture and improving application security and maintainability.",
          "Improved Ruby on Rails GraphQL API performance by 25% and reduced JavaScript bundle sizes by 40%, decreasing page load times and improving perceived application responsiveness.",
          "Extended the conference registration platform to support an additional department, eliminating a third-party vendor contract and saving tens of thousands of dollars annually.",
          "Rebuilt the interactive campus map in React, generating 130 prospective student leads in its first year.",
          "Implemented electronic HR submission and approval workflows using Ruby on Rails, GraphQL, and TypeScript, replacing paper-based processes and reducing manual administrative work.",
          "Established team workflows for integrating AI-assisted development tools (Claude Code) into daily development, accelerating implementation, debugging, architectural exploration, and refactoring.",
          "Mentored software engineers through code reviews, pair programming, and technical coaching, helping teammates resolve complex problems while promoting maintainable engineering practices.",
        ]}
      />
      <Experience
        company="Cru"
        title="High School Field Staff"
        start="08/2017"
        end="10/2022"
        bullets={[
          "Coordinated high school ministry programs and conferences, mentored student leaders, and maintained $120K in annual donor support.",
        ]}
      />
      <Experience
        company="Cru"
        title="Intern Software Developer"
        start="08/2016"
        end="08/2017"
        bullets={[
          "Developed the AngularJS frontend for the single-page rewrite of MissionHub, enabling campus staff to record, aggregate, and analyze ministry metrics across organizational levels.",
          "Implemented frontend support for migrating conference registration payment processing to a PCI-compliant third-party provider.",
        ]}
      />
    </div>
  </div>
</article>

<style>
  /*
    One resume DOM, two layouts driven entirely by CSS:
    - @media screen: a 2-column grid (sticky dark sidebar + main experience).
    - @media print:  .aside/.aside-inner/.main become display:contents so their
      children promote into the .resume grid, then `order` reflows them into the
      single-column black-on-white document (name + contact header, summary,
      experience, education, skills). Screen-only chrome (back link, PDF
      button, rules) is hidden.
  */

  /* ---- screen: dark 2-column resume page ---- */
  @media screen {
    .resume {
      width: var(--page-w);
      max-width: 100%;
      min-height: 100dvh;
      display: grid;
      grid-template-columns: var(--sidebar-w) 1fr;
      grid-template-rows: 1fr;
    }

    .aside {
      padding: var(--space-12) var(--space-9);
      border-right: 1px solid var(--border);
    }

    .aside-inner {
      position: sticky;
      top: var(--space-12);
    }

    .main {
      min-width: 0;
      padding: var(--space-12);
    }

    .back {
      display: inline-block;
      margin-bottom: var(--space-7);
      font-size: var(--fs-sm);
      color: var(--muted-2);
      transition: color var(--dur) ease;

      &:hover {
        color: var(--text-2);
      }
    }

    .aside-inner :global(.name-role) {
      margin-bottom: var(--space-7);
    }

    .identity,
    .contact-line {
      display: contents;
    }

    .contact {
      margin: 0 0 var(--space-7);
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      font-size: var(--fs-sm);
      color: var(--text-3);

      .sep {
        display: none;
      }
    }

    .pdf-btn {
      display: block;
      width: fit-content;
      font-size: var(--fs-sm);
      font-weight: 600;
      color: var(--bg);
      background: var(--accent);
      border-radius: var(--radius-btn);
      padding: var(--space-2) var(--space-5);
      margin-bottom: var(--space-8);
      transition: background var(--dur) ease;

      &:hover {
        background: var(--accent-hi);
      }
    }

    .side-rule {
      height: 1px;
      background: var(--border);
      margin: var(--space-6) 0;
    }

    .section-label {
      font-family: var(--font-display);
      font-size: var(--fs-xs);
      font-weight: 400;
      letter-spacing: var(--ls-caps);
      text-transform: uppercase;
      color: var(--accent);
    }

    .label-skills,
    .label-education {
      margin: 0 0 var(--space-4);
    }

    .label-experience {
      margin: 0 0 var(--space-2);
    }

    .skills {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .main-rule {
      height: 1px;
      background: var(--border);
      margin-bottom: var(--space-8);
    }

    .summary {
      margin: 0 0 var(--space-8);
      font-size: var(--fs-base);
      line-height: var(--lh-base);
      color: var(--text-3);
      text-wrap: pretty;
    }

    .roles {
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }
  }

  @media screen and (width <= 960px) {
    /* Flatten the two-column wrappers into one column matching the PDF reading order. */
    .resume {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      min-height: 0;
      row-gap: var(--space-6);
      padding: var(--space-6);
    }

    .aside,
    .aside-inner,
    .main {
      display: contents;
    }

    .summary {
      order: 1;
    }

    .label-experience,
    .roles {
      order: 2;
    }

    .label-education,
    .education {
      order: 3;
    }

    .label-skills,
    .skills {
      order: 4;
    }

    /* Spacing comes from the grid row-gap; drop the desktop/section margins so
       they don't stack with it. */
    .back,
    .contact,
    .pdf-btn,
    .summary,
    .label-experience,
    .label-education,
    .label-skills,
    .aside-inner :global(.name),
    .aside-inner :global(.name-role) {
      margin: 0;
    }

    /* Border-top divides the header from the body, replacing the sidebar's
       screen border. */
    .label-experience {
      padding-top: var(--space-8);
      border-top: 1px solid var(--border);
    }

    /* Contact on one line. */
    .contact {
      flex-direction: row;
      flex-wrap: wrap;
      column-gap: var(--space-2);

      .sep {
        display: inline;
      }
    }

    /* Underline rules don't fit the single-column flow. */
    .side-rule,
    .main-rule {
      display: none;
    }
  }

  /* ---- print: single-column black-on-white document ---- */
  @media print {
    .resume {
      display: grid;
      grid-template-columns: 1fr;
      color: var(--print-body);
      font-size: 10pt;
      line-height: 1.22;
      /* Generic system font for print: deterministic metrics, no webfont. */
      font-family: Arial, sans-serif;
    }

    /* Dissolve the screen wrappers so their children become grid items. */
    .aside,
    .aside-inner,
    .main {
      display: contents;
    }

    /* Screen-only chrome. */
    .back,
    .pdf-btn,
    .side-rule,
    .main-rule,
    .aside-inner :global(.name-role) {
      display: none;
    }

    .aside-inner :global(.name) {
      margin: 0;
      font-family: inherit;
      font-size: 20pt;
      font-weight: 700;
      letter-spacing: var(--ls-tight);
      /* Keep the print leading (from .resume) rather than the tight screen
         line-height the shared .name now carries. */
      line-height: inherit;
      color: var(--print-ink);
    }

    .identity {
      order: 1;
      display: flex;
      justify-content: space-between;
      align-items: last baseline;
      gap: var(--space-6);
    }

    .contact {
      margin: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      color: var(--print-body);
      font-size: 9pt;

      :global(a) {
        color: inherit;
        text-decoration: none;
      }

      .sep {
        display: inline;
        color: var(--print-faint);
      }

      .sep-group {
        display: none;
      }
    }

    .contact-line {
      display: flex;
      gap: var(--space-1);
    }

    .section-label {
      margin: 9pt 0 4pt;
      padding-bottom: 3pt;
      border-bottom: 1px solid var(--print-rule);
      font-family: inherit;
      font-size: 12pt;
      font-weight: 500;
      color: var(--print-ink);
    }

    .summary {
      order: 3;
      margin: 0.35rem 0 0;
      font-size: 10pt;
      line-height: 1.22;
      color: var(--print-body);
    }

    .label-experience {
      order: 4;
    }

    .roles {
      order: 4;
      display: flex;
      flex-direction: column;
      gap: 12pt;
    }

    .label-education {
      order: 5;
    }

    .education {
      order: 5;
      display: flex;
      flex-direction: column;
      gap: 12pt;
    }

    .label-skills {
      order: 6;
    }

    .skills {
      order: 6;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 2pt;
    }
  }
</style>
