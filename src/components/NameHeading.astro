---
import { profile } from "../data/profile";

const { firstName, lastName, title } = profile;
---

<h1 class="name">{firstName} <br class="name-break" />{lastName}</h1>
<div class="role">{title}</div>

<style>
  .name {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--fs-3xl);
    font-weight: 700;
    letter-spacing: var(--ls-tight);
    line-height: var(--lh-tight);
  }

  .role {
    font-size: var(--fs-base);
    color: var(--muted);
  }

  /* The name stacks onto two lines only on wide layouts; hide the <br>
     wherever the name reads as one line. */
  @media (width <= 960px), print {
    .name-break {
      display: none;
    }
  }
</style>
