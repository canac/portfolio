---
import { profile } from "../data/profile";
import NameHeading from "./NameHeading.astro";

const { github, linkedin, email } = profile;

const navLinks = [
  { label: "About", href: "#about" },
  { label: "Projects", href: "#projects" },
  { label: "Experience", href: "#experience" },
  { label: "Open Source", href: "#open-source" },
];
---

<aside class="sidebar">
  <div class="sidebar-inner">
    <NameHeading />
    <nav class="nav">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="sidebar-rule"></div>
    <div class="social">
      <a
        class="link-accent"
        href={github}
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
      <a
        class="link-accent"
        href={linkedin}
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn
      </a>
      <a class="link-accent" href={`mailto:${email}`}>Email</a>
      <a class="link-accent" href="/resume">Resume</a>
    </div>
  </div>
</aside>

<style>
  .sidebar {
    width: var(--sidebar-w);
    flex: none;
    padding: var(--space-12) var(--space-9);
    border-right: 1px solid var(--border);
  }

  .sidebar-inner {
    position: sticky;
    top: var(--space-12);
  }

  .sidebar-inner :global(.name-role) {
    margin-bottom: var(--space-8);
  }

  .nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: var(--fs-base);
    margin-bottom: var(--space-8);

    a {
      color: var(--nav);
      transition: color var(--dur) ease;

      &:hover {
        color: var(--text);
      }
    }
  }

  .sidebar-rule {
    height: 1px;
    background: var(--border);
    margin-bottom: var(--space-6);
  }

  .social {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--fs-base);
  }

  @media (width <= 960px) {
    .sidebar {
      width: 100%;
      padding: var(--space-6);
      border-right: none;
      border-bottom: 1px solid var(--border);
    }

    .sidebar-inner {
      position: static;
      top: auto;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .sidebar-inner :global(.name),
    .sidebar-inner :global(.name-role) {
      margin: 0;
    }

    .nav,
    .sidebar-rule {
      display: none;
    }

    .social {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
</style>
