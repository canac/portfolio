---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Skip the .page/.main sidebar wrapper and render the slot directly (the resume owns its own layout). */
  bare?: boolean;
}

const { title, description, bare = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {
      bare ? (
        <slot />
      ) : (
        <div class="page">
          <slot name="sidebar" />
          <main class="main">
            <slot />
          </main>
        </div>
      )
    }
  </body>
</html>

<style>
  .page {
    width: var(--page-w);
    max-width: 100%;
    display: flex;
  }

  .main {
    flex: 1;
    min-width: 0;
    padding: var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  @media (width <= 960px) {
    .page {
      flex-direction: column;
    }

    .main {
      padding: var(--space-10);
    }
  }
</style>
